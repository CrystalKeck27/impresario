# Development-only PostgreSQL credentials. Never reuse these in production.
POSTGRES_DB=impresario_dev
POSTGRES_USER=impresario
POSTGRES_PASSWORD=impresario_local_dev_only
POSTGRES_PORT=5432

# Connection string for a host-run application (not currently used by the app).
DATABASE_URL=postgres://impresario:impresario_local_dev_only@localhost:5432/impresario_dev
