{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "kill processes on port 3000",
            "type": "shell",
            "command": "sh",
            "args": [
                "-c",
                "ss -H -ltnp sport = :3000 | grep -o pid=[0-9][0-9]* | cut -d= -f2 | sort -u | xargs -r kill"
            ],
            "problemMatcher": []
        },
        {
            "label": "cargo leptos watch",
            "type": "shell",
            "command": "cargo",
            "args": [
                "leptos",
                "watch"
            ],
            "dependsOn": "kill processes on port 3000",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^error.*?([^\\s].*):(\\d+):(\\d+): (.*)$",
                    "file": 1,
                    "location": 2,
                    "message": 4
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*leptos watch.*$",
                    "endsPattern": "^.*Watching for file changes.*$"
                }
            }
        }
    ]
}
